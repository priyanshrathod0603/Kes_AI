generator client {
  provider           = "prisma-client-js"
  prettierFormatter   = "prettier"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SchoolClass {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects  Subject[]
  documents Document[]

  @@index([name])
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  classId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  chapters    Chapter[]
  documents   Document[]

  @@index([name])
  @@index([classId])
}

model Chapter {
  id          String   @id @default(uuid())
  name        String
  description String?
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject  @relation(fields: [subjectId], references: [id])
  topics    Topic[]
  documents Document[]

  @@index([name])
  @@index([subjectId])
}

model Topic {
  id        String   @id @default(uuid())
  name      String
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id])
  documents Document[]

  @@index([name])
  @@index([chapterId])
}

model Document {
  id           String   @id @default(uuid())
  title        String
  fileName     String
  filePath     String
  fileType     String
  fileSize     Int
  documentType String   @default("STUDY_MATERIAL")
  processed    Boolean  @default(false)
  extractedText String?
  
  // Extraction tracking fields
  extractionStatus String   @default("PENDING")
  extractionError  String?
  extractedAt      DateTime?
  pageCount        Int?
  characterCount   Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolClassId String?
  subjectId     String?
  chapterId     String?
  topicId       String?

  schoolClass SchoolClass? @relation(fields: [schoolClassId], references: [id])
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  chapter     Chapter?      @relation(fields: [chapterId], references: [id])
  topic       Topic?         @relation(fields: [topicId], references: [id])

  @@index([title])
  @@index([fileType])
  @@index([documentType])
  @@index([schoolClassId])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([extractionStatus])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?
  subjectId   String?
  chapterId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   QuizQuestion[]

  @@index([subjectId])
  @@index([chapterId])
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A" | "B" | "C" | "D"
  explanation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Worksheet {
  id              String   @id @default(uuid())
  title           String
  schoolName      String   @default("KRISHNA ENGLISH SCHOOL")
  schoolSubHeader String   @default("Pre-Primary-Primary School")
  academicYear    String   @default("2026-27")
  examName        String   @default("FA 1")
  worksheetNumber String?  @default("1")
  className       String
  subjectName     String
  chapterName     String?
  topicName       String?
  difficulty      String   @default("Medium")
  contentJson     String
  documentId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  schoolClassId   String?
  subjectId       String?

  @@index([className])
  @@index([subjectName])
  @@index([createdAt])
}

model QuestionPaper {
  id              String   @id @default(uuid())
  title           String
  schoolName      String   @default("KRISHNA ENGLISH SCHOOL")
  schoolSubHeader String   @default("Pre-Primary-Primary School")
  academicYear    String   @default("2026-27")
  examName        String   @default("FA 1 EXAMINATION")
  className       String
  subjectName     String
  totalMarks      Int      @default(25)
  duration        String   @default("1 Hour")
  difficulty      String   @default("Medium")
  contentJson     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  schoolClassId   String?
  subjectId       String?

  @@index([className])
  @@index([subjectName])
  @@index([createdAt])
}

